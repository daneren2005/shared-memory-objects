{
  "name": "@daneren2005/shared-memory-objects",
  "version": "1.0.0",
  "author": "daneren2005@gmail.com",
  "description": "Creating objects with a SharedArrayBuffer",
  "homepage": "https://github.com/daneren2005/shared-memory-objects#readme",
  "keywords": [
    "sharedarraybuffer"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/daneren2005/shared-memory-objects.git"
  },
  "bugs": {
    "url": "https://github.com/daneren2005/shared-memory-objects/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/"
  ],
  "exports": {
    "./*": {
      "import": {
        "types": "./dist/src/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "preview": "vite preview",
    "publish:manual": "npm publish --access public",
    "release": "semantic-release",
    "start": "npm run dev",
    "test:bench": "vitest bench",
    "test:ui": "vitest --ui --api 9527",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "type-check": "tsc --build --force",
    "prepare": "husky"
  },
  "devDependencies": {
    "@semantic-release/git": "^10.0.1",
    "@tsconfig/node24": "^24.0.1",
    "@types/node": "^24.9.1",
    "@vitest/coverage-v8": "^4.0.1",
    "@vitest/eslint-plugin": "^1.3.23",
    "@vitest/ui": "^4.0.1",
    "eslint": "^9.38.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "pretty-bytes": "^7.1.0",
    "semantic-release": "^25.0.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "unplugin-dts": "^1.0.0-beta.6",
    "vite": "^7.1.11",
    "vitest": "^4.0.1"
  }
}
